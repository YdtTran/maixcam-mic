# Camera Wi-Fi/LAN address, reachable from the PC.
MAIX_IP=192.168.1.7
# Optional direct USB address used by diagnostics.
MAIX_USB_IP=10.172.16.1
# scripts/deploy.ps1 writes these discovered values into ignored .env only:
# LAPTOP_WIFI_IP, MAIXCAM_WIFI_IP, LAPTOP_USB_IP, MAIXCAM_USB_IP,
# MAIXCAM_WIFI_MAC, EARBUDS_MAC (supplied through -HeadsetMac).
# Keep these settings for the supported Docker route.
RTSP_TRANSPORT=tcp
STREAM_MODE=video
# Fixed camera mounting offset, counter-clockwise: 0, 90, 180 or 270.
CAMERA_BASE_ROTATION=0
# legacy = video-only MP4. multistream = video + mixed/worker/operator audio.
RECORDING_MODE=multistream
